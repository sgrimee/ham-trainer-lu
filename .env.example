# Copy to .env (gitignored) and fill in. mise autoloads .env on entering the
# directory; the container gets the same names from its orchestrator instead.
#
# Grading works without any of this -- with no key the app falls back to
# showing the reference answer and letting the candidate mark themselves
# (specs/APP.md §7.3). Only the key is secret; the URL and model are not.

# Nous Research, OpenAI-compatible (specs/APP.md §8.1)
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_API_KEY=

# specs/APP.md §8.2 explains the choice and the alternatives. Constraints:
# the model must support structured outputs, must not be a ':batch' variant,
# and should not force reasoning -- study mode grades inline. Note gpt-5.x
# rejects `temperature`; use reasoning_effort instead.
LLM_MODEL=openai/gpt-5.1
# Measured against tests/grading_fixtures.py -- all three score 11/12:
# LLM_MODEL=mistralai/mistral-medium-3.1   # 5x cheaper, but saw upstream 429s and 18s spikes
# LLM_MODEL=anthropic/claude-opus-5        # 7x dearer, no measured advantage
# Re-check with: mise run eval-grader <model>

# In a container, prefer a mounted secret over LLM_API_KEY (specs/APP.md §11.3).
# When set, this wins:
# LLM_API_KEY_FILE=/run/secrets/llm_api_key

# Where candidate attempts are stored. Default: var/attempts.db (specs/APP.md §5.1).
# The container image overrides this to point into its volume (specs/APP.md §11.2).
# ATTEMPTS_DB=var/attempts.db
